{
  "name": "@orkestra/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsx build.ts",
    "check": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/desktop.tsbuildinfo",
    "test": "vitest run",
    "start": "electron .",
    "package": "tsx package.ts",
    "install-app": "tsx install.ts",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@orkestra/shared": "workspace:*"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.1.1",
    "electron": "44.0.0",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
